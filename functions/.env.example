# functions/.env.example
#
# Variáveis de ambiente para Firebase Cloud Functions.
# Copie este arquivo para functions/.env e preencha os valores.
# O arquivo functions/.env está no .gitignore — nunca o commite.
#
# Referência: https://firebase.google.com/docs/functions/config-env

# ── Chave da API Google (se usar Gemini / Google AI) ──────────────────────────
GOOGLE_AI_API_KEY=sua_chave_aqui

# ── Chave de integração Mercado Pago (quando implementado) ────────────────────
MERCADOPAGO_ACCESS_TOKEN=seu_token_aqui
MERCADOPAGO_PUBLIC_KEY=sua_public_key_aqui

# ── Configurações de notificação (FCM já usa Firebase Admin — não precisa de key extra) ──
# FCM_SERVER_KEY=opcional_se_usar_legado

# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=production
