{
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rules": "firebase emulators:exec --only database --project demo-treino \"jest -c jest.rules.config.js\"",
    "predeploy": "node scripts/bump-cache.js",
    "deploy": "vercel --prod",
    "test:functions": "firebase emulators:exec --only auth,database,functions --project demo-treino \"jest -c jest.functions.config.js\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  }
}
