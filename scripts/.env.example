# Renomeie este arquivo para .env e preencha com sua chave

# Usado por: scripts/popular-gifs-workoutx.js
# Chave grátis da WorkoutX (500 req/mês, sem cartão)
# Obtenha em: https://workoutxapp.com/dashboard.html#register
WORKOUTX_KEY=sua_chave_aqui

# DB_SECRET (Firebase Console → Configurações → Contas de serviço → Secrets do banco de dados)
# passe direto na linha de comando, não precisa colocar aqui:
# $env:DB_SECRET="..."; $env:WORKOUTX_KEY="..."; node scripts/popular-gifs-workoutx.js
